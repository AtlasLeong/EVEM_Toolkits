{
  "name": "front-codex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:tactical": "vite --host 127.0.0.1 --port 4194 --strictPort --mode tactical-local",
    "dev:starsea": "vite --host 127.0.0.1 --port 4195 --strictPort --mode starsea-local",
    "build": "vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",

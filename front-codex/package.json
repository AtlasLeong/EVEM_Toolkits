    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.7",
    "sharp": "^0.35.4",
    "vite": "^7.3.1"
  }

# MERGE into the existing HTTPS server after review. Not a complete server config.
# Preserve existing server_name, TLS certificate, /api/ and /admin/ proxy settings.
root /EVEMTK/deploy/current/frontend;

location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
}
location = /deploy-version.json {
    try_files $uri =404;
    add_header Cache-Control "no-store" always;
}
location /assets/ {
    alias /EVEMTK/deploy/shared/assets/;
    add_header Cache-Control "public, max-age=31536000, immutable";
}
location /static/uploads/ {
    alias /EVEMTK/EVEM_Toolkits/backend/static/uploads/;
}
location /static/ {
    alias /EVEMTK/deploy/current/backend/static/;
}
